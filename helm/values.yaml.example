# Copy to a private values file and replace database connection placeholders.
# From helm/:
#   cp values.yaml.example values.yml
#   chmod 600 values.yml
#   helm lint ./ai48home --strict -f values.yml
#   helm upgrade --install ai48home ./ai48home -n ai48home --create-namespace -f values.yml --wait --timeout 10m
# Never commit the private file or real credentials.

fullnameOverride: ai48home
clusterDomain: cluster.local
timezone: Asia/Jakarta

# Optional credentials for private image registries.
imagePullSecrets: []
# imagePullSecrets:
#   - name: registry-credentials

# Use a StorageClass available in your cluster (check: kubectl get storageclass).
# Component storageClass values below override this global fallback.
global:
  storageClass: nfs-client

# Empty keys are generated on first install and reused from ai48home-config.
# For GitOps/offline rendering, supply stable, independently generated keys.
# Changing these values after bootstrap does not update database-backed config;
# synchronize changes through the Management API as described in README.md.
secrets:
  managementKey: ""
  gatewayApiKey: ""

bootstrap:
  image: python:3.13-alpine

# Home always runs one replica with the Recreate strategy.
home:
  image:
    repository: ghcr.io/sofyan48/ai48home
    # Pin a tested release tag for production.
    tag: latest
    pullPolicy: Always
  heartbeatTimeoutSeconds: 20
  # Environment values are stored in a ConfigMap: do not put secrets here.
  environment:
    HOME_USER_EMAIL_SMTP_PASSWORD: ""
  persistence:
    size: 5Gi
    storageClass: nfs-client
  resources: {}
  service:
    # Exposes HTTP on 80 and HTTP/RESP-mTLS on 8327 inside the cluster.
    # Keep management access private; use /admin/connect to sign in.
    type: ClusterIP

workers:
  image:
    repository: eceasy/cli-proxy-api
    tag: v8.0.4
    pullPolicy: IfNotPresent
  # Used only when autoscaling.enabled is false.
  replicas: 1
  # Must exceed home.heartbeatTimeoutSeconds; adds 2 seconds per pod ordinal.
  startDelaySeconds: 25
  # Non-sensitive settings only; HOME_URL, TZ and delay are chart-managed.
  environment: {}
  # Each worker gets its own PVC for its automatically enrolled JWT/identity.
  persistence:
    size: 5Gi
    storageClass: nfs-client
  resources:
    requests:
      # A CPU request is required for CPU-based autoscaling.
      cpu: 250m
      memory: 256Mi
  service:
    # Worker HTTP API is exposed on 80 and 8317.
    # Set LoadBalancer if your cluster supports external load balancers.
    type: ClusterIP
  autoscaling:
    # Requires Metrics Server and Kubernetes 1.30+.
    # Set false to use workers.replicas without these requirements.
    enabled: true
    minReplicas: 1
    maxReplicas: 8
    targetCPUUtilizationPercentage: 70
    scaleDownStabilizationSeconds: 300

postgresql:
  # External database by default. Create the database/user before installing.
  # For chart-managed PostgreSQL, set true; external settings are then ignored.
  enabled: false
  # Also used by Home's database-check init container in external mode.
  image:
    repository: postgres
    tag: 17-alpine
    pullPolicy: IfNotPresent
  # Internal PostgreSQL listener and connection settings.
  port: 5432
  sslmode: disable
  # These credentials apply to BOTH internal and external PostgreSQL.
  auth:
    username: ai48home
    database: ai48home
    # REQUIRED: replace with the external user's actual password, or generate
    # an independent password (openssl rand -hex 32) for a new internal DB.
    # Changing this value does not rotate a password in an existing database.
    password: "REPLACE_WITH_DATABASE_PASSWORD"
  external:
    host: postgres.example.com
    port: 5432
    # Match your database's TLS policy; require enables TLS.
    sslmode: require
  # Non-sensitive settings only; connection variables are chart-managed.
  environment: {}
  # Used only for internal PostgreSQL.
  persistence:
    size: 10Gi
    storageClass: nfs-client
  resources: {}
